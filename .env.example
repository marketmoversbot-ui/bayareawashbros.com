# ─── Database ──────────────────────────────────────────────────
# Postgres connection string. Railway provides this when you add
# a Postgres service to the project — copy DATABASE_URL from Railway
# → your Postgres service → Variables → "Connect" tab.
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# ─── NextAuth ──────────────────────────────────────────────────
# Random 32+ char secret. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Public URL of the site. In Railway set this to your production
# domain (e.g. https://bayareawashbros.com). Locally use http://localhost:3000.
NEXTAUTH_URL="http://localhost:3000"

# ─── Seed-only (used once when running `npm run db:seed`) ──────
# These create the son's admin login. After seeding once, you can
# remove them. Password must be at least 10 characters.
ADMIN_EMAIL="son@example.com"
ADMIN_PASSWORD="change-this-to-something-strong"
ADMIN_NAME="Son's Name"

# ─── Phase 3+ (Twilio SMS) — leave blank for now ───────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Phase 4 (Stripe) — leave blank for now ────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Phase 4 (Google Calendar) — leave blank for now ───────────
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
