// Bay Area Wash Bros — data model
// Postgres on Railway. One schema covers all phases (auth, scheduling, SMS, bookings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// ---------- People & jobs ----------

model Customer {
  id        String    @id @default(cuid())
  // E.164 format, e.g. "+18328819960"
  phone     String    @unique
  name      String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]
  messages  Message[]
}

model Booking {
  id              String         @id @default(cuid())
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  startsAt        DateTime
  endsAt          DateTime
  service         String         // e.g. "Driveway + sidewalk"
  priceCents      Int
  status          BookingStatus  @default(PENDING)
  paymentStatus   PaymentStatus  @default(UNPAID)

  // Payment tracking — populated when marked paid
  paymentMethod   String?        // "CASH" | "VENMO" | "ZELLE" | "CHECK" | "OTHER"
  paymentNote     String?        // free-text, e.g. "his uncle paid", check #1234
  paidAt          DateTime?      // when the payment was recorded

  stripeSessionId String?
  googleEventId   String?
  notes           String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([paymentStatus])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
  REFUNDED
}

// ---------- Availability ----------

model AvailabilityRule {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean @default(true)
  createdAt DateTime @default(now())
}

model AvailabilityException {
  id        String   @id @default(cuid())
  date      DateTime
  isBlock   Boolean
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([date])
}

// ---------- SMS ----------

model Message {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  direction  MessageDirection
  body       String
  twilioSid  String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([customerId, createdAt])
  @@index([read])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model QuickReply {
  id        String   @id @default(cuid())
  label     String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
